// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id                String           @id @default(uuid())
  email             String           @unique
  userName          String           @unique
  bio               String?
  fName             String?
  lName             String?
  profileImg        String?
  bannerImg         String?
  posts             Post[]
  comments          Comment[]
  likedPost         PostLike[]
  likedComments     CommentLike[]
  sentRequests      Friend[]        @relation("SentFriendReq")
  receivedRequests  Friend[]        @relation("ReceivedFriendReq")

  groupMemberships GroupMember[]
}
model Post { 
  id             Int       @id @default(autoincrement()) 
  title          String
  content        String?
  tags           String[]
  images         String[]
  createdAt      DateTime  @default(now())
  status         String    @default("draft")
  authorId       String
  author         User      @relation(fields: [authorId], references: [id]) 
  viewers        Viewers[]
  comments       Comment[]
  likedPost      PostLike[]
  groupId        Int?
  group          Group?      @relation(fields: [groupId], references: [id])
}
model Comment {
  id           Int            @id @default(autoincrement())
  content      String
  createdAt    DateTime       @default(now())
  commenterId  String
  commenter    User           @relation(fields: [commenterId], references: [id])
  postId       Int
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes        CommentLike[]
}
model Group{ 
  id               Int      @id @default(autoincrement())
  groupName        String   @unique
  description      String
  groupImg         String
  bannerImg        String
  groupThemes      String[]
  posts            Post[]
  groupMembers     GroupMember[]
}
model GroupMember{
  memberId  String
  member    User     @relation(fields: [memberId], references: [id])
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  role      String   @default("member")

  @@id([memberId, groupId])
}
model Notifications {
  id         Int      @id @default(autoincrement())
  content    String
  link       String
  createdAt  DateTime  @default(now())
}
model Friend {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime @default(now())
  status      String   @default("PENDING")
  userId      String
  user        User      @relation("SentFriendReq", fields: [userId], references: [id]) 
  receiverId  String
  receiver    User     @relation("ReceivedFriendReq", fields: [receiverId], references: [id])
  @@unique([userId, receiverId]) 
}
model Viewers {
  id         Int       @id @default(autoincrement())
  postId     Int
  viewerId   String
  post       Post      @relation(fields: [postId], references: [id])
  @@unique([postId, viewerId])
}
model PostLike {
  id         Int       @id @default(autoincrement())
  type       String
  postId     Int
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade) 
  likerId    String
  liker      User     @relation(fields: [likerId], references: [id])
  @@unique([postId, likerId])
}
model CommentLike {
  id         Int       @id @default(autoincrement())
  type       String
  commentId  Int
  comment    Comment   @relation(fields: [commentId], references: [id]) 
  likerId    String
  liker      User     @relation(fields: [likerId], references: [id])
  @@unique([commentId, likerId])
}